// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================
// LOCATION HIERARCHY MODELS
// ==================================================

/// Country model representing India
model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status    String    @default("active") // active, inactive

  // Relations
  states    State[]

  @@map("country")
}

/// State model representing states/UTs in India
model State {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  countryId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status    String    @default("active")

  // Relations
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts District[]
  userAccess UserStateAccess[]

  // Indexes
  @@index([countryId])
  @@map("state")
}

/// District model
model District {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  stateId   Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status    String    @default("active")

  // Relations
  state     State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  subDistricts SubDistrict[]

  // Indexes
  @@index([stateId])
  @@map("district")
}

/// SubDistrict model (Taluk/Block)
model SubDistrict {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  districtId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  status    String    @default("active")

  // Relations
  district  District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  villages  Village[]

  // Indexes
  @@index([districtId])
  @@map("sub_district")
}

/// Village model
model Village {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  subDistrictId Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  status        String    @default("active")

  // Relations
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id], onDelete: Cascade)

  // Indexes for efficient searching
  @@index([subDistrictId])
  @@index([name])
  @@map("village")
}

// ==================================================
// USER & AUTHENTICATION MODELS
// ==================================================

/// User model for dashboard and API access
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  planType        String    @default("free") // free, basic, premium, enterprise
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  status          String    @default("active") // active, suspended, deleted

  // Relations
  apiKeys         ApiKey[]
  apiLogs         ApiLog[]
  stateAccess     UserStateAccess[]

  @@index([email])
  @@map("user")
}

/// API Key model for B2B/programmatic access
model ApiKey {
  id              Int       @id @default(autoincrement())
  key             String    @unique  // Public key
  secretHash      String    // Hashed secret key
  name            String?
  userId          Int
  lastUsedAt      DateTime?
  requestCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  status          String    @default("active") // active, revoked, expired

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiLogs         ApiLog[]

  // Indexes for efficient lookups
  @@index([userId])
  @@index([key])
  @@map("api_key")
}

/// User State Access control (who can access which states)
model UserStateAccess {
  id        Int       @id @default(autoincrement())
  userId    Int
  stateId   Int
  createdAt DateTime  @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     State     @relation(fields: [stateId], references: [id], onDelete: Cascade)

  // Unique constraint to prevent duplicates
  @@unique([userId, stateId])
  @@index([userId])
  @@index([stateId])
  @@map("user_state_access")
}

// ==================================================
// ANALYTICS & LOGGING MODELS
// ==================================================

/// API request logging for analytics and rate limiting
model ApiLog {
  id              Int       @id @default(autoincrement())
  endpoint        String    // e.g., /api/v1/villages/search
  method          String    // GET, POST, etc
  statusCode      Int?
  responseTime    Int       // milliseconds
  userAgent       String?
  ipAddress       String?
  userId          Int?
  apiKeyId        Int?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  // Relations
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKey          ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  // Indexes for efficient querying
  @@index([createdAt])
  @@index([userId])
  @@index([apiKeyId])
  @@index([endpoint])
  @@map("api_log")
}

// ==================================================
// NOTES:
// 
// 1. Status fields are strings to allow flexibility
//    without creating separate enums
//
// 2. Timestamps (createdAt, updatedAt) are automatic
//
// 3. Indexes are created on:
//    - Foreign keys (automatic)
//    - Search columns (name, email, key)
//    - Filter columns (createdAt, status)
//
// 4. Cascade delete ensures data consistency:
//    - Deleting country cascades to states
//    - Deleting state cascades to districts
//    - Etc.
//
// 5. User-State relationship allows permission control
//
// 6. ApiLog tracks all requests for analytics and
//    audit purposes
//
// 7. PostgreSQL native types:
//    - Serial/Int for IDs
//    - String/Varchar for text
//    - DateTime for timestamps
//    - Boolean for flags
// ==================================================
