# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/indian_locations

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_should_be_changed
JWT_EXPIRY=7d

# Redis Configuration (Upstash or local Redis)
REDIS_URL=redis://localhost:6379

# Upstash Redis (optional, if using Upstash instead of local Redis)
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Key Configuration
API_KEY_PREFIX=INDIAN_LOC_
