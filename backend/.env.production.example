# Production Environment
NODE_ENV=production

# Database Configuration (NeonDB)
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# JWT Configuration (use strong secret in production)
JWT_SECRET=your_production_jwt_secret_min_32_characters_generate_secure_random
JWT_EXPIRY=7d

# Redis Configuration (Upstash)
UPSTASH_REDIS_REST_URL=https://your-region-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_secure_rest_token

# Server Configuration
PORT=3000
CORS_ORIGIN=https://your-frontend-domain.com

# Rate Limiting (stricter in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Key Configuration
API_KEY_PREFIX=INDIAN_LOC_
